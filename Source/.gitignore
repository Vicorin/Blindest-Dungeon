# Claude Code local settings
.claude/

# Build output
bin/
obj/

# This project's actual build outputs (MSVC, not .NET â€” bin/ and obj/ never match).
# Regenerable by Mod\build.ps1 and launcher\build.ps1; the copies that matter are
# deployed next to Darkest.exe.
Mod/build/
# Generated by Mod\build.ps1 from Mod\lang\*.txt on every build (the embedded translations);
# committing it would only let it go stale.
Mod/src/core/axlang_embedded.inc
launcher/build/
proxy/build/
installer/build/

# A third-party installer kept locally as a reference while building the install manager
# (its logic and window layout are modelled on it). Not ours, so never committed.
HarkestDungeonInstaller.exe

# Release packages assembled by package.ps1 -- pure copies of the build outputs above plus
# release\, so the ZIP is regenerable and only the SHIPPED artefact (attached to a GitHub
# release) is worth keeping. release\ itself, the hand-written player documents, IS tracked.
dist/

# Decompiled game code (large, user-specific)
decompiled/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vs/
.vscode/
*.user
*.suo

# Scratch notes and stray local files that are not part of the project.
docs/claude-md-improvements.md
nul
*.zip

# Python bytecode cache from the port tooling in re-notes/
__pycache__/
